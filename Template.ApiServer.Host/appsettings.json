{
  "http_ports": "8080",

  "AllowedHosts": "*",

  "FeatureManagement": {
    "CustomOption": true
  },

  "ConnectionStrings": {
    "Default": "Data Source=data.db;Cache=Shared;Pooling=True"
  },

  "Auth": {
    "SecretKey": "template-api-server-secret-key-0123456789abcdef",
    "Issuer": "TemplateApiServer",
    "Audience": "TemplateApiServer",
    "ExpireMinutes": 60,
    "ApiKey": "template-api-key",
    "Users": [
      {
        "Id": "test",
        "Password": "test",
        "Roles": [ "Administrator" ]
      }
    ]
  },

  "Limit": {
    "Global": {
      "Window": 10,
      "PermitLimit": 100,
      "QueueLimit": 0
    },
    "Auth": {
      "Window": 60,
      "PermitLimit": 10,
      "QueueLimit": 0
    }
  },

  "Storage": {
    "Root": "storage"
  },

  "Log": {
    "HttpLog": false
  },

  "Profiler": {
    "SqlTrace": false
  },

  "Prometheus": {
    "Uri": "http://0.0.0.0:9464"
  },

  "Serilog": {
    "Using": [
      "Serilog.Enrichers.Environment",
      "Serilog.Sinks.File"
    ],
    "Enrich": [ "FromLogContext", "WithThreadId", "WithMachineName" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "../log/Template.ApiServer.Host_.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:HH:mm:ss.fff} {Level:u4} {MachineName} [{SourceContext}] [{ThreadId}] {TraceId} {RequestId} {RequestPath} - {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
